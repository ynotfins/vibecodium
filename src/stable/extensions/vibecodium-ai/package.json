{
  "name": "vibecodium-ai",
  "displayName": "Vibecodium AI",
  "description": "Vibecodium AI workbench surfaces: cross-project graph, context and memory.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "vibecodium",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onCommand:vibecodium.graph.open",
    "onCommand:vibecodium.graph.setData",
    "onCommand:vibecodium.memory.open",
    "onCommand:vibecodium.memory.setStore",
    "onCommand:vibecodium.providers.open",
    "onCommand:vibecodium.providers.setSetup"
  ],
  "contributes": {
    "configuration": {
      "title": "Vibecodium AI",
      "properties": {
        "chat.welcomePage.signIn.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a GitHub sign-in button on the Chat welcome page. Vibecodium keeps this off so a fresh profile never asks for GitHub Copilot."
        }
      }
    },
    "configurationDefaults": {
      "chat.disableAIFeatures": false,
      "chat.titleBar.signIn.enabled": false,
      "chat.welcomePage.signIn.enabled": false
    },
    "commands": [
      {
        "command": "vibecodium.graph.open",
        "title": "Open Graph Panel",
        "category": "Vibecodium"
      },
      {
        "command": "vibecodium.memory.open",
        "title": "Open Memory Review",
        "category": "Vibecodium"
      },
      {
        "command": "vibecodium.providers.open",
        "title": "Open Provider Setup",
        "category": "Vibecodium"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vibecodium.graph.open"
        },
        {
          "command": "vibecodium.memory.open"
        },
        {
          "command": "vibecodium.providers.open"
        }
      ]
    }
  }
}
