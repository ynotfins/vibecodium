# Binary files
*.bmp
*.icns
*.ico
*.png
*.xpm

# File types with a mixed formatting which seems to be intentional.
# Disabling only check for some properties (like indent_size) is currently not supported.

# Some mixed indentation due to alignment with previous line
stores/snapcraft/{stable,insider}/snap/local/bin/electron-launch

# Vibecodium research archive: imported reports keep their original formatting
docs/vibe/research/**

# Governance proposals embed exact unified diffs (blank context lines are a single space)
.vibe/governance/proposals/**

# Vendored tree-sitter WASM runtime and grammars: third-party artifacts whose
# formatting is pinned by size and checksum in the vendor README.
src/stable/index-engine/vendor/tree-sitter/**

# Third-party licence texts and the notice generated from them: verbatim upstream
# bytes pinned by SHA-256 in vibe/notices.json, so their indentation must not be
# reformatted (reformatting would change the digest and the licence text).
vibe/licenses/**
docs/vibe/legal/**
